;;;; src/transpiler/modules.lisp -- whole-module and whole-project compilation

(in-package :monolisp.transpiler)

(defun module-name-from-path (path)
  "foo.client.lisp -> (values \"foo\" nil); foo.clientx.lisp -> (values \"foo\" t)"
  (let* ((name (pathname-name path))
         (dot (position #\. name :from-end t)))
    (cond ((null dot) (values name nil))
          (t (let ((suffix (subseq name (1+ dot))))
               (cond ((string-equal suffix "clientx") (values (subseq name 0 dot) t))
                     ((string-equal suffix "client") (values (subseq name 0 dot) nil))
                     (t (values name nil))))))))

(defun compile-module (forms &key (name "module") tsx-p (config *config*) package file)
  "Compile FORMS (already read) into a MODULE whose OUTPUT is TypeScript source."
  (let* ((*config* config)
         (*module* (make-module :name name :tsx-p tsx-p :package (or package (make-client-package name))))
         (*current-file* file)
         (*struct-ts-name-hook* (lambda (sym)
                                  (let ((info (or (gethash sym (module-structs *module*))
                                                  (gethash (symbol-name sym) *project-structs*))))
                                    (and info (struct-info-ts-name info)))))
         (env (make-env))
         (warnings '()))
    (prescan-lambda-lists forms *module*)
    (let ((body (capture-statements
                  (handler-bind ((transpile-warning (lambda (w)
                                                      (push (format nil "~A" w) warnings)
                                                      (muffle-warning w))))
                    (dolist (form forms)
                      (let ((*current-toplevel* form))
                        (cs form env :void)))))))
      (setf (module-warnings *module*) (nreverse warnings))
      (let ((text (concatenate 'string (module-header *module* body) body)))
        ;; every client file is an ES module, even one holding only inline aliases
        (unless (es-module-text-p text)
          (setf text (concatenate 'string text (format nil "export {};~%"))))
        (setf (module-output *module*) text))
      *module*)))

(defun prescan-lambda-lists (forms module)
  "Record the lambda list of every top-level defun, so calls that precede the definition still
know its &key parameters."
  (dolist (form forms)
    (let ((f form))
      (loop while (and (consp f) (member (sym-name (car f)) '("EXPORT" "EXPORT-DEFAULT" "ASYNC") :test #'equal)
                       (consp (second f)))
            do (setf f (second f)))
      (when (and (consp f) (sym-is (car f) "DEFUN") (symbolp (second f)) (listp (third f)))
        (setf (gethash (second f) (module-lambda-lists module)) (third f))))))

(defun es-module-text-p (text)
  "True when some line of TEXT starts with an import or export statement."
  (with-input-from-string (s text)
    (loop for line = (read-line s nil) while line
          thereis (or (eql 0 (search "import " line)) (eql 0 (search "export " line))))))

(defun module-header (module body)
  "Auto-generated import lines."
  (with-output-to-string (s)
    (format s "// Generated by Monolisp.ts from ~A.~A.lisp -- do not edit.~%"
            (module-name module) (if (module-tsx-p module) "clientx" "client"))
    (when (and (module-tsx-p module) (module-react-used module) (config-react-p *config*))
      (unless (gethash (intern "React" (module-package module)) (module-globals module))
        (format s "import React from ~A;~%" (js-string (config-react-import *config*)))))
    (let ((auto (remove-if (lambda (call)
                             (member (cdr call) (module-server-imports module)
                                     :test (lambda (js sym) (string= js (mangle-name sym)))))
                           (module-server-calls module))))
      (when auto
        (format s "import { ~{~A~^, ~} } from ~A;~%"
                (sort (remove-duplicates (mapcar #'cdr auto) :test #'string=) #'string<)
                (js-string (config-stubs-module *config*)))))
    (when (search "rpcCall(" body)
      (format s "import { rpcCall } from ~A;~%" (js-string (config-stubs-runtime-module *config*))))
    (terpri s)))

(defun config-stubs-runtime-module (config)
  (declare (ignore config))
  "./monolisp-runtime")

(defun transpile-forms (forms &rest args &key &allow-other-keys)
  (module-output (apply #'compile-module forms args)))

(defun transpile-string (text &key (name "module") tsx-p (config *config*) file)
  "Transpile frontend Lisp source TEXT to TypeScript.  Returns (values output module)."
  (let* ((*project-structs* (make-hash-table :test 'equal))
         (*project-struct-accessors* (make-hash-table :test 'equal))
         (*project-modules* (make-hash-table :test 'equal))
         (package (make-client-package name))
         (forms (read-client-source text :package package :file file))
         (module (compile-module forms :name name :tsx-p tsx-p :config config :package package :file file)))
    (values (module-output module) module)))

(defun transpile-file (path &key out-dir (config *config*))
  "Transpile one .client.lisp / .clientx.lisp file.  Returns (values output-path module)."
  (multiple-value-bind (name tsx-p) (module-name-from-path path)
    (let* ((text (uiop:read-file-string path :external-format :utf-8))
           (out-dir (uiop:ensure-directory-pathname (or out-dir (directory-namestring path))))
           (out-path (merge-pathnames (format nil "~A.~A" name (if tsx-p "tsx" "ts")) out-dir)))
      (multiple-value-bind (output module) (transpile-string text :name name :tsx-p tsx-p :config config :file (namestring path))
        (write-text-file out-path output)
        (values out-path module)))))

(defun client-source-files (src-dir)
  (let ((dir (uiop:ensure-directory-pathname src-dir)))
    (remove-if-not (lambda (p) (let ((n (pathname-name p)))
                                 (or (search ".client" n) (search ".clientx" n))))
                   (uiop:directory-files dir "*.lisp"))))

(defun sibling-imports (forms module-names)
  "Names of sibling modules imported at top level of FORMS."
  (loop for f in forms
        when (and (consp f) (sym-is (car f) "IMPORT"))
          append (let ((name (sibling-module-name (getf (cdr f) :from) module-names)))
                   (and name (list name)))))

(defun order-modules (entries)
  "ENTRIES: list of (name forms path tsx-p).  Topological order by sibling imports."
  (let ((names (mapcar #'first entries)) (done '()) (result '()))
    (labels ((visit (entry stack)
               (let ((name (first entry)))
                 (cond ((member name done :test #'string=) nil)
                       ((member name stack :test #'string=)
                        (error 'transpile-error :message (format nil "circular import between modules ~{~A~^ -> ~}" (reverse (cons name stack)))))
                       (t (dolist (dep (sibling-imports (second entry) names))
                            (let ((dep-entry (find dep entries :key #'first :test #'string=)))
                              (when dep-entry (visit dep-entry (cons name stack)))))
                          (push name done)
                          (push entry result))))))
      (dolist (e entries) (visit e '())))
    (nreverse result)))

(defun transpile-project (src-dir out-dir &key (manifest (and (fboundp 'server-manifest) (server-manifest)))
                                            (react-p t) (strict-server-calls t))
  "Transpile every client module under SRC-DIR into OUT-DIR, together with the server stubs and
runtime.  Returns a plist (:outputs (paths) :warnings (strings) :modules (module structs))."
  (let* ((files (client-source-files src-dir))
         (entries (mapcar (lambda (path)
                            (multiple-value-bind (name tsx-p) (module-name-from-path path)
                              (let ((package (make-client-package name)))
                                (list name
                                      (read-client-source (uiop:read-file-string path :external-format :utf-8)
                                                          :package package :file (namestring path))
                                      path tsx-p package))))
                          files))
         (config (make-transpile-config :react-p react-p :manifest manifest :strict-server-calls strict-server-calls
                                        :module-names (mapcar #'first entries)))
         (*project-structs* (make-hash-table :test 'equal))
         (*project-struct-accessors* (make-hash-table :test 'equal))
         (*project-modules* (make-hash-table :test 'equal))
         (outputs '()) (warnings '()) (modules '()))
    (dolist (entry (order-modules entries))
      (destructuring-bind (name forms path tsx-p package) entry
        (let* ((module (compile-module forms :name name :tsx-p tsx-p :config config :package package :file (namestring path)))
               (out-path (merge-pathnames (format nil "~A.~A" name (if tsx-p "tsx" "ts"))
                                          (uiop:ensure-directory-pathname out-dir))))
          (setf (gethash name *project-modules*) module)
          (write-text-file out-path (module-output module))
          (push out-path outputs)
          (push module modules)
          (setf warnings (append warnings (module-warnings module))))))
    (when manifest
      (setf outputs (append (write-alignment-files out-dir :manifest manifest) outputs)))
    (list :outputs (nreverse outputs) :warnings warnings :modules (nreverse modules))))
