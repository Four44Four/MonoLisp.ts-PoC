;;;; src/transpiler/loop.lisp -- the LOOP macro for the frontend dialect
;;;;
;;;; LOOP is re-implemented here (rather than expanding the host's LOOP, whose TAGBODY/GO output is
;;;; hostile to structured targets) and expands into a handful of structured primitives:
;;;;   (block NAME (let* (...) initially... (%while t items...) finally... RESULT))
;;;; or, for a single array/map driver, (%for-of (var sequence) ...).  The compiler turns those
;;;; into labelled blocks, `while (true)`, `for (const x of xs)`, `break` and `return`.

(in-package :monolisp.transpiler)

(defun cl-sym (name) (intern name :cl))
(defun lang-sym (name) (intern name :monolisp.client-lang))

(defun loop-kw-p (token &rest names)
  (and (symbolp token) (not (keywordp token))
       (member (symbol-name token) names :test #'string=)))

(defstruct (loop-driver (:conc-name ld-))
  kind            ; :across :range :equals :repeat :hash-keys :hash-values :hash-entries
  var             ; symbol or list of symbols
  extra           ; :across -> sequence form ; :range -> plist ; :equals -> (init step) ; :repeat -> count
  terminating-p)

(defun expand-loop (form)
  "Expand (loop ...) into structured primitive forms."
  (let ((tokens (cdr form))
        (name nil)
        (withs '())            ; (var init)
        (drivers '())
        (prologue-items '())   ; while/until tests interleaved with driver tests (kept in order)
        (initially '())
        (body '())
        (finally '())
        (accumulators '())     ; (var kind) kind :list :sum :count :max :min
        (result-form nil)
        (default-acc nil))
    (when (and tokens (loop-kw-p (first tokens) "NAMED"))
      (pop tokens) (setf name (pop tokens)))
    (labels ((peek () (first tokens))
             (next () (if tokens (pop tokens) (tfail form "loop: unexpected end of clauses")))
             (blk () name)
             (ensure-acc (kind into)
               (let ((var (or into (or default-acc (setf default-acc (gensym "ACC"))))))
                 (let ((existing (assoc var accumulators)))
                   (cond ((null existing) (push (list var kind) accumulators))
                         ((not (eq (second existing) kind))
                          (tfail form "loop: ~A is accumulated in incompatible ways" var))))
                 var))
             (parse-into ()
               (when (loop-kw-p (peek) "INTO") (next) (next)))
             (acc-form (kind var expr)
               (ecase kind
                 (:list `(,(lang-sym "ARRAY-PUSH") ,var ,expr))
                 (:append `(,(lang-sym "ARRAY-PUSH") ,var (,(lang-sym "SPREAD") ,expr)))
                 (:sum `(,(cl-sym "INCF") ,var ,expr))
                 (:count `(,(cl-sym "WHEN") ,expr (,(cl-sym "INCF") ,var 1)))
                 (:max `(,(cl-sym "SETF") ,var (,(cl-sym "IF") (,(cl-sym "EQ") ,var nil) ,expr (,(cl-sym "MAX") ,var ,expr))))
                 (:min `(,(cl-sym "SETF") ,var (,(cl-sym "IF") (,(cl-sym "EQ") ,var nil) ,expr (,(cl-sym "MIN") ,var ,expr))))))
             (parse-body-clause ()
               "One clause usable inside the main body or a conditional.  Returns a form."
               (let ((tok (next)))
                 (cond
                   ((loop-kw-p tok "DO" "DOING")
                    (let ((forms '()))
                      (loop while (and tokens (consp (peek))) do (push (next) forms))
                      (when (null forms) (tfail form "loop: DO needs at least one compound form"))
                      `(,(cl-sym "PROGN") ,@(nreverse forms))))
                   ((loop-kw-p tok "COLLECT" "COLLECTING")
                    (let* ((expr (next)) (into (parse-into)) (var (ensure-acc :list into)))
                      (acc-form :list var expr)))
                   ((loop-kw-p tok "APPEND" "APPENDING" "NCONC" "NCONCING")
                    (let* ((expr (next)) (into (parse-into)) (var (ensure-acc :list into)))
                      (acc-form :append var expr)))
                   ((loop-kw-p tok "SUM" "SUMMING")
                    (let* ((expr (next)) (into (parse-into)) (var (ensure-acc :sum into)))
                      (acc-form :sum var expr)))
                   ((loop-kw-p tok "COUNT" "COUNTING")
                    (let* ((expr (next)) (into (parse-into)) (var (ensure-acc :count into)))
                      (acc-form :count var expr)))
                   ((loop-kw-p tok "MAXIMIZE" "MAXIMIZING")
                    (let* ((expr (next)) (into (parse-into)) (var (ensure-acc :max into)))
                      (acc-form :max var expr)))
                   ((loop-kw-p tok "MINIMIZE" "MINIMIZING")
                    (let* ((expr (next)) (into (parse-into)) (var (ensure-acc :min into)))
                      (acc-form :min var expr)))
                   ((loop-kw-p tok "RETURN")
                    (let ((expr (next)))
                      `(,(cl-sym "RETURN-FROM") ,(blk) ,expr)))
                   ((loop-kw-p tok "WHEN" "IF" "UNLESS")
                    (let* ((test (next))
                           (test (if (loop-kw-p tok "UNLESS") `(,(cl-sym "NOT") ,test) test))
                           (then (list (parse-body-clause))))
                      (loop while (loop-kw-p (peek) "AND") do (next) (push (parse-body-clause) then))
                      (let ((else '()))
                        (when (loop-kw-p (peek) "ELSE")
                          (next)
                          (push (parse-body-clause) else)
                          (loop while (loop-kw-p (peek) "AND") do (next) (push (parse-body-clause) else)))
                        (when (loop-kw-p (peek) "END") (next))
                        `(,(cl-sym "IF") ,test
                          (,(cl-sym "PROGN") ,@(nreverse then))
                          ,@(when else `((,(cl-sym "PROGN") ,@(nreverse else))))))))
                   ((loop-kw-p tok "WHILE")
                    `(,(cl-sym "UNLESS") ,(next) (,(lang-sym "%BREAK"))))
                   ((loop-kw-p tok "UNTIL")
                    `(,(cl-sym "WHEN") ,(next) (,(lang-sym "%BREAK"))))
                   ((loop-kw-p tok "ALWAYS")
                    (setf result-form t)
                    `(,(cl-sym "UNLESS") ,(next) (,(cl-sym "RETURN-FROM") ,(blk) :false)))
                   ((loop-kw-p tok "NEVER")
                    (setf result-form t)
                    `(,(cl-sym "WHEN") ,(next) (,(cl-sym "RETURN-FROM") ,(blk) :false)))
                   ((loop-kw-p tok "THEREIS")
                    (let ((g (gensym "IT")))
                      `(,(cl-sym "LET") ((,g ,(next))) (,(cl-sym "WHEN") ,g (,(cl-sym "RETURN-FROM") ,(blk) ,g)))))
                   ((consp tok)
                    ;; bare compound form (extension): treated as DO
                    tok)
                   (t (tfail form "loop: unknown or misplaced clause ~A" tok)))))
             (parse-for ()
               (let ((var (next)) (tok (next)))
                 (cond
                   ((loop-kw-p tok "ACROSS" "IN" "OVER")
                    (push (make-loop-driver :kind :across :var var :extra (next) :terminating-p t) drivers))
                   ((loop-kw-p tok "ON")
                    (tfail form "loop: FOR ... ON is list-based and not supported; use ACROSS"))
                   ((loop-kw-p tok "=")
                    (let ((init (next)) (step nil))
                      (when (loop-kw-p (peek) "THEN") (next) (setf step (next)))
                      (push (make-loop-driver :kind :equals :var var :extra (list init (or step init) (and step t))) drivers)))
                   ((loop-kw-p tok "BEING")
                    (next)                                   ; THE / EACH
                    (let ((what (next)))
                      (cond ((loop-kw-p what "ELEMENTS" "ELEMENT")
                             (unless (loop-kw-p (next) "OF" "IN") (tfail form "loop: expected OF"))
                             (push (make-loop-driver :kind :across :var var :extra (next) :terminating-p t) drivers))
                            ((loop-kw-p what "HASH-KEYS" "HASH-KEY")
                             (unless (loop-kw-p (next) "OF" "IN") (tfail form "loop: expected OF"))
                             (let ((table (next)) (value-var nil))
                               (when (loop-kw-p (peek) "USING")
                                 (next)
                                 (let ((spec (next)))
                                   (unless (and (consp spec) (loop-kw-p (first spec) "HASH-VALUE"))
                                     (tfail form "loop: expected USING (hash-value v)"))
                                   (setf value-var (second spec))))
                               (push (if value-var
                                         (make-loop-driver :kind :hash-entries :var (list var value-var) :extra table :terminating-p t)
                                         (make-loop-driver :kind :hash-keys :var var :extra table :terminating-p t))
                                     drivers)))
                            ((loop-kw-p what "HASH-VALUES" "HASH-VALUE")
                             (unless (loop-kw-p (next) "OF" "IN") (tfail form "loop: expected OF"))
                             (let ((table (next)) (key-var nil))
                               (when (loop-kw-p (peek) "USING")
                                 (next)
                                 (let ((spec (next)))
                                   (unless (and (consp spec) (loop-kw-p (first spec) "HASH-KEY"))
                                     (tfail form "loop: expected USING (hash-key k)"))
                                   (setf key-var (second spec))))
                               (push (if key-var
                                         (make-loop-driver :kind :hash-entries :var (list key-var var) :extra table :terminating-p t)
                                         (make-loop-driver :kind :hash-values :var var :extra table :terminating-p t))
                                     drivers)))
                            (t (tfail form "loop: unsupported BEING clause ~A" what)))))
                   ((loop-kw-p tok "FROM" "UPFROM" "DOWNFROM" "TO" "BELOW" "ABOVE" "DOWNTO" "BY")
                    (let ((plist '()) (down (loop-kw-p tok "DOWNFROM")))
                      (push tok tokens)
                      (loop while (loop-kw-p (peek) "FROM" "UPFROM" "DOWNFROM" "TO" "BELOW" "ABOVE" "DOWNTO" "BY" "UPTO")
                            do (let ((k (next)) (v (next)))
                                 (cond ((loop-kw-p k "FROM" "UPFROM" "DOWNFROM") (setf (getf plist :from) v))
                                       ((loop-kw-p k "TO" "UPTO") (setf (getf plist :to) v))
                                       ((loop-kw-p k "DOWNTO") (setf (getf plist :to) v down t))
                                       ((loop-kw-p k "BELOW") (setf (getf plist :below) v))
                                       ((loop-kw-p k "ABOVE") (setf (getf plist :above) v down t))
                                       ((loop-kw-p k "BY") (setf (getf plist :by) v)))))
                      (setf (getf plist :down) down)
                      (push (make-loop-driver :kind :range :var var :extra plist
                                              :terminating-p (and (or (getf plist :to) (getf plist :below) (getf plist :above)) t))
                            drivers)))
                   (t (tfail form "loop: unsupported FOR clause ~A ~A" var tok))))))
      ;; ---- clause loop
      (loop while tokens
            do (let ((tok (peek)))
                 (cond
                   ((loop-kw-p tok "WITH")
                    (next)
                    (loop
                      (let ((var (next)) (init nil))
                        (when (loop-kw-p (peek) "=") (next) (setf init (next)))
                        (push (list var init) withs))
                      (if (loop-kw-p (peek) "AND") (next) (return))))
                   ((loop-kw-p tok "FOR" "AS")
                    (next) (parse-for)
                    (loop while (loop-kw-p (peek) "AND") do (next) (parse-for)))
                   ((loop-kw-p tok "REPEAT")
                    (next)
                    (push (make-loop-driver :kind :repeat :var (gensym "REPEAT") :extra (next) :terminating-p t) drivers))
                   ((loop-kw-p tok "INITIALLY")
                    (next)
                    (loop while (and tokens (consp (peek))) do (push (next) initially)))
                   ((loop-kw-p tok "FINALLY")
                    (next)
                    (loop while (and tokens (consp (peek)))
                          do (let ((f (next)))
                               ;; (finally (return x)) -> result
                               (push (if (and (consp f) (loop-kw-p (first f) "RETURN"))
                                         `(,(cl-sym "RETURN-FROM") ,(blk) ,(second f))
                                         f)
                                     finally))))
                   ((and (loop-kw-p tok "WHILE" "UNTIL") (null body))
                    ;; while/until before the body: evaluated in driver order
                    (push (parse-body-clause) prologue-items))
                   (t (push (parse-body-clause) body))))))
    (setf drivers (nreverse drivers) withs (nreverse withs) initially (nreverse initially)
          body (nreverse body) finally (nreverse finally) prologue-items (nreverse prologue-items))
    ;; ---- choose a strategy
    (let* ((terminating (remove-if-not #'ld-terminating-p drivers))
           (for-of-driver (and (= (length terminating) 1)
                               (member (ld-kind (first terminating)) '(:across :hash-keys :hash-values :hash-entries))
                               (eq (first terminating) (first drivers))   ; it's the primary driver
                               (first terminating)))
           (bindings '())
           (items '())           ; per-iteration items in order (driver tests/binds, then while/until)
           (steps '())
           (result (cond ((eq result-form t) t)
                         (default-acc default-acc)
                         (t nil))))
      ;; with
      (dolist (w withs) (push (list (first w) (second w)) bindings))
      ;; accumulators
      (dolist (a accumulators)
        (destructuring-bind (var kind) a
          (push (list var (ecase kind
                            ((:list :append) `(,(cl-sym "THE") (,(cl-sym "ARRAY") t) (,(cl-sym "VECTOR"))))
                            ((:sum :count) 0)
                            ((:max :min) `(,(cl-sym "THE") (,(cl-sym "OR") ,(cl-sym "REAL") ,(cl-sym "NULL")) nil))))
                bindings)))
      ;; drivers
      (dolist (d drivers)
        (ecase (ld-kind d)
          (:across
           (unless (eq d for-of-driver)
             (let ((idx (gensym "I")) (seq (gensym "SEQ")))
               (push (list seq (ld-extra d)) bindings)
               (push (list idx 0) bindings)
               (if (consp (ld-var d))
                   (progn (dolist (v (ld-var d)) (push (list v nil) bindings))
                          (push `(,(cl-sym "UNLESS") (,(cl-sym "<") ,idx (,(cl-sym "LENGTH") ,seq)) (,(lang-sym "%BREAK"))) items)
                          (push `(,(cl-sym "SETF") (,(cl-sym "VALUES") ,@(ld-var d)) (,(cl-sym "AREF") ,seq ,idx)) items))
                   (progn (push (list (ld-var d) nil) bindings)
                          (push `(,(cl-sym "UNLESS") (,(cl-sym "<") ,idx (,(cl-sym "LENGTH") ,seq)) (,(lang-sym "%BREAK"))) items)
                          (push `(,(cl-sym "SETF") ,(ld-var d) (,(cl-sym "AREF") ,seq ,idx)) items)))
               (push `(,(cl-sym "INCF") ,idx) steps))))
          ((:hash-keys :hash-values :hash-entries)
           (unless (eq d for-of-driver)
             (tfail form "loop: hash-table iteration must be the primary (first, only terminating) driver")))
          (:range
           (let* ((p (ld-extra d)) (var (ld-var d)) (down (getf p :down))
                  (from (or (getf p :from) (if down (tfail form "loop: DOWNTO/ABOVE needs FROM") 0)))
                  (by (or (getf p :by) 1)))
             (push (list var from) bindings)
             (cond ((getf p :to) (push `(,(cl-sym "UNLESS") (,(cl-sym (if down ">=" "<=")) ,var ,(getf p :to)) (,(lang-sym "%BREAK"))) items))
                   ((getf p :below) (push `(,(cl-sym "UNLESS") (,(cl-sym "<") ,var ,(getf p :below)) (,(lang-sym "%BREAK"))) items))
                   ((getf p :above) (push `(,(cl-sym "UNLESS") (,(cl-sym ">") ,var ,(getf p :above)) (,(lang-sym "%BREAK"))) items)))
             (push `(,(cl-sym (if down "DECF" "INCF")) ,var ,by) steps)))
          (:equals
           (destructuring-bind (init step has-step) (ld-extra d)
             (push (list (ld-var d) init) bindings)
             (when has-step (push `(,(cl-sym "SETF") ,(ld-var d) ,step) steps))))
          (:repeat
           (push (list (ld-var d) (ld-extra d)) bindings)
           (push `(,(cl-sym "UNLESS") (,(cl-sym ">") ,(ld-var d) 0) (,(lang-sym "%BREAK"))) items)
           (push `(,(cl-sym "DECF") ,(ld-var d)) steps))))
      (setf items (append (nreverse items) prologue-items)
            steps (nreverse steps))
      (let* ((loop-form
               (if for-of-driver
                   (let* ((d for-of-driver)
                          (source (ecase (ld-kind d)
                                    (:across (ld-extra d))
                                    (:hash-keys `(,(lang-sym "..") ,(ld-extra d) (keys)))
                                    (:hash-values `(,(lang-sym "..") ,(ld-extra d) (values)))
                                    (:hash-entries (ld-extra d)))))
                     `(,(lang-sym "%FOR-OF") (,(ld-var d) ,source) ,@items ,@body ,@steps))
                   `(,(lang-sym "%WHILE") t ,@items ,@body ,@steps)))
             (inner `(,(cl-sym "LET*") ,(nreverse bindings)
                      ,@initially
                      ,loop-form
                      ,@finally
                      ,result)))
        `(,(cl-sym "BLOCK") ,name ,inner)))))
