;;;; tests/types-tests.lisp -- schema validation / encoding / TypeScript rendering

(defpackage :monolisp.test.types
  (:use :cl :monolisp.test :monolisp.json :monolisp.rpc))

(in-package :monolisp.test.types)

(define-rpc-struct test-point
  (x fixnum)
  (y fixnum)
  (label string :optional t))

(define-rpc-struct test-shape
  (kind (member "circle" "square"))
  (points (array test-point))
  (meta (map string) :optional t))

(defun v (schema json) (validate-value schema (json-parse json)))

(deftest name-mangling (:suite "types")
  (is-equal "helloWorld" (lisp-name->camel 'hello-world))
  (is-equal "x" (lisp-name->camel 'x))
  (is-equal "doThingNow" (lisp-name->camel "do-thing-now"))
  (is-equal "GLOBAL_STATE" (lisp-name->camel '*global-state*))
  (is-equal "isOkP" (lisp-name->camel 'is-ok-p))
  (is-equal "HelloWorld" (lisp-name->pascal 'hello-world))
  (is-equal "hello-world" (camel->lisp-name "helloWorld")))

(deftest validate-primitives (:suite "types")
  (is-equal "s" (v 'string "\"s\""))
  (is-equal 5 (v 'integer "5"))
  (is-equal 5 (v 'fixnum "5"))
  (is-equal 2.5d0 (v 'number "2.5"))
  (is-equal 3 (v 'number "3"))
  (is-equal 3d0 (v 'float "3"))
  (is-equal t (v 'boolean "true"))
  (is-equal nil (v 'boolean "false"))
  (is-equal nil (v 'null "null"))
  (is-equal :true (v 'any "true")))

(deftest validate-primitive-mismatches (:suite "types")
  (signals schema-error (v 'string "5"))
  (signals schema-error (v 'string "null"))
  (signals schema-error (v 'integer "5.0"))
  (signals schema-error (v 'integer "\"5\""))
  (signals schema-error (v 'fixnum "9007199254740993"))      ; beyond 2^53
  (signals schema-error (v 'number "\"1\""))
  (signals schema-error (v 'boolean "1"))
  (signals schema-error (v 'boolean "\"true\""))
  (signals schema-error (v 'null "false")))

(deftest validate-bounded-types (:suite "types")
  (is-equal "abc" (v '(string 3) "\"abc\""))
  (signals schema-error (v '(string 3) "\"abcd\""))
  (is-equal 5 (v '(integer 0 10) "5"))
  (signals schema-error (v '(integer 0 10) "11"))
  (signals schema-error (v '(integer 0 10) "-1"))
  (is-equal 100 (v '(integer 0 *) "100")))

(deftest validate-compound (:suite "types")
  (is-equal #(1 2) (v '(array integer) "[1,2]") 'equalp)
  (signals schema-error (v '(array integer) "[1,\"2\"]"))
  (signals schema-error (v '(array integer 1) "[1,2]"))
  (signals schema-error (v '(array integer) "{}"))
  (is-equal #(1 "a") (v '(tuple integer string) "[1,\"a\"]") 'equalp)
  (signals schema-error (v '(tuple integer string) "[1]"))
  (is-equal "a" (v '(or integer string) "\"a\""))
  (is-equal nil (v '(nullable string) "null"))
  (is-equal "x" (v '(nullable string) "\"x\""))
  (signals schema-error (v '(or integer string) "true"))
  (is-equal "circle" (v '(member "circle" "square") "\"circle\""))
  (is-equal 2 (v '(member 1 2) "2"))
  (signals schema-error (v '(member "circle") "\"CIRCLE\""))
  (is-equal :a (v '(member :a :b) "\"a\"")))

(deftest validate-objects (:suite "types")
  (let ((obj (v '(object (first-name string) (age integer :optional)) "{\"firstName\":\"Al\"}")))
    (is-equal "Al" (json-get obj "firstName")))
  (signals schema-error (v '(object (first-name string)) "{}"))
  (signals schema-error (v '(object (first-name string)) "{\"firstName\":\"Al\",\"extra\":1}"))
  (let ((m (v '(map integer) "{\"a\":1,\"b\":2}")))
    (is-equal 2 (json-get m "b")))
  (signals schema-error (v '(map integer) "{\"a\":\"x\"}")))

(deftest validate-structs (:suite "types")
  (let ((p (v 'test-point "{\"x\":1,\"y\":2}")))
    (is (test-point-p p))
    (is-equal 1 (test-point-x p))
    (is-equal nil (test-point-label p)))
  (let ((p (v 'test-point "{\"x\":1,\"y\":2,\"label\":\"origin\"}")))
    (is-equal "origin" (test-point-label p)))
  (signals schema-error (v 'test-point "{\"x\":1}"))
  (signals schema-error (v 'test-point "{\"x\":1,\"y\":2,\"z\":3}"))
  (signals schema-error (v 'test-point "[1,2]"))
  (let ((s (v 'test-shape "{\"kind\":\"circle\",\"points\":[{\"x\":0,\"y\":0}]}")))
    (is (test-shape-p s))
    (is (test-point-p (svref (test-shape-points s) 0)))))

(deftest schema-error-paths-are-safe (:suite "types")
  (handler-case (v 'test-shape "{\"kind\":\"circle\",\"points\":[{\"x\":0,\"y\":\"SECRET\"}]}")
    (schema-error (e)
      (let ((text (princ-to-string e)))
        (is (search "$.points[0].y" text))
        (is-false (search "SECRET" text) "error message must not echo payload")))))

(deftest encode-values (:suite "types")
  (is-equal "s" (encode-value 'string "s"))
  (is-equal :true (encode-value 'boolean t))
  (is-equal :false (encode-value 'boolean nil))
  (is-equal :null (encode-value 'null nil))
  (is-equal 2.5d0 (encode-value 'number 5/2))
  (is-equal #(1 2) (encode-value '(array integer) '(1 2)) 'equalp)
  (is-equal #(1 2) (encode-value '(array integer) #(1 2)) 'equalp)
  (is-equal "{\"x\":1,\"y\":2}" (json-encode (encode-value 'test-point (make-test-point :x 1 :y 2))))
  (is-equal "{\"x\":1,\"y\":2,\"label\":\"L\"}" (json-encode (encode-value 'test-point (make-test-point :x 1 :y 2 :label "L"))))
  (is-equal "{\"a\":1}" (json-encode (encode-value '(map integer) '(("a" . 1)))))
  (is-equal "{\"firstName\":\"x\"}" (json-encode (encode-value '(object (first-name string)) '((first-name . "x")))))
  ;; plists are the idiomatic way to return an object from a server function
  (is-equal "{\"total\":3,\"nextCursor\":null}"
            (json-encode (encode-value '(object (total fixnum) (next-cursor (nullable fixnum))) '(:total 3 :next-cursor nil))))
  (is-equal "{\"items\":[1,2]}" (json-encode (encode-value '(object (items (array integer))) '(:items (1 2)))))
  (is-equal "a" (encode-value '(member :a :b) :a)))

(deftest encode-mismatch-signals (:suite "types")
  (signals schema-error (encode-value 'string 5))
  (signals schema-error (encode-value 'integer "5"))
  (signals schema-error (encode-value 'test-point (make-test-shape)))
  (signals schema-error (encode-value '(tuple integer) '(1 2))))

(deftest schema-to-typescript (:suite "types")
  (is-equal "string" (schema->ts 'string))
  (is-equal "number" (schema->ts 'fixnum))
  (is-equal "number" (schema->ts '(integer 0 10)))
  (is-equal "boolean" (schema->ts 'boolean))
  (is-equal "null" (schema->ts 'null))
  (is-equal "unknown" (schema->ts 'any))
  (is-equal "number[]" (schema->ts '(array integer)))
  (is-equal "(string | null)[]" (schema->ts '(array (nullable string))))
  (is-equal "[number, string]" (schema->ts '(tuple integer string)))
  (is-equal "string | null" (schema->ts '(nullable string)))
  (is-equal "\"circle\" | \"square\"" (schema->ts '(member "circle" "square")))
  (is-equal "\"a\" | 1" (schema->ts '(member :a 1)))
  (is-equal "Record<string, number>" (schema->ts '(map number)))
  (is-equal "{ firstName: string; age?: number; }" (schema->ts '(object (first-name string) (age integer :optional))))
  (is-equal "TestPoint" (schema->ts 'test-point))
  (is-equal "TestPoint[]" (schema->ts '(array test-point))))

(deftest schema-validity (:suite "types")
  (is (schema-valid-p 'string))
  (is (schema-valid-p '(array (or string null))))
  (is (schema-valid-p 'test-point))
  (is-false (schema-valid-p 'no-such-struct))
  (is-false (schema-valid-p '(array)))
  (is-false (schema-valid-p '(member)))
  (is-false (schema-valid-p '(frobnicate string))))
