;;;; tests/json-tests.lisp -- JSON parser / encoder unit tests (attack vectors live in attack-tests.lisp)

(defpackage :monolisp.test.json
  (:use :cl :monolisp.test :monolisp.json))

(in-package :monolisp.test.json)

(defun parse (s) (json-parse s))
(defun roundtrip (s) (json-encode (json-parse s)))

(deftest parse-literals (:suite "json")
  (is-equal :true (parse "true"))
  (is-equal :false (parse "false"))
  (is-equal :null (parse "null"))
  (is-equal :true (parse "  true  ")))

(deftest parse-numbers (:suite "json")
  (is-equal 0 (parse "0"))
  (is-equal -0 (parse "-0"))
  (is-equal 42 (parse "42"))
  (is-equal -17 (parse "-17"))
  (is-equal 12345678901234567890 (parse "12345678901234567890"))
  (is-equal 1.5d0 (parse "1.5"))
  (is-equal -0.25d0 (parse "-0.25"))
  (is-equal 1d10 (parse "1e10"))
  (is-equal 1.5d-3 (parse "1.5E-3"))
  (is-equal 100d0 (parse "1e+2"))
  (is-equal 0d0 (parse "0.0"))
  (is-equal 0.1d0 (parse "0.1"))
  (is-equal 1d300 (parse "1e300"))
  (is-equal 0d0 (parse "1e-500"))
  (is (typep (parse "1.0") 'double-float))
  (is (integerp (parse "10"))))

(deftest parse-strings (:suite "json")
  (is-equal "" (parse "\"\""))
  (is-equal "hello" (parse "\"hello\""))
  (is-equal (format nil "a~Cb" #\Newline) (parse "\"a\\nb\""))
  (is-equal "\"\\/" (parse "\"\\\"\\\\\\/\""))
  (is-equal (coerce (list (code-char 8) (code-char 12) (code-char 13) (code-char 9)) 'string)
            (parse "\"\\b\\f\\r\\t\""))
  (is-equal "A" (parse "\"\\u0041\""))
  (is-equal (string (code-char #x1F600)) (parse "\"\\uD83D\\uDE00\""))
  (is-equal (string (code-char #xE9)) (parse "\"\\u00e9\""))
  ;; raw UTF-8 in input
  (is-equal (string (code-char #xE9)) (parse (format nil "\"~A\"" (code-char #xE9))))
  (is-equal (string (code-char #x1F600)) (parse (format nil "\"~A\"" (code-char #x1F600)))))

(deftest parse-arrays (:suite "json")
  (is-equal #() (parse "[]") 'equalp)
  (is-equal #(1 2 3) (parse "[1,2,3]") 'equalp)
  (is-equal #(1 #(2 #(3))) (parse "[1,[2,[3]]]") 'equalp)
  (is-equal #(:true :null "x") (parse " [ true , null , \"x\" ] ") 'equalp))

(deftest parse-objects (:suite "json")
  (let ((obj (parse "{\"a\": 1, \"b\": [true], \"c\": {\"d\": null}}")))
    (is (json-object-p obj))
    (is-equal '("a" "b" "c") (json-keys obj))
    (is-equal 1 (json-get obj "a"))
    (is-equal :true (json-ref obj "b" 0))
    (is-equal :null (json-ref obj "c" "d"))
    (is-equal nil (json-ref obj "c" "missing"))
    (is-equal :dflt (json-get obj "zzz" :dflt))
    (is (json-has-key-p obj "a"))
    (is-false (json-has-key-p obj "A"))
    (is-equal 3 (json-object-count obj)))
  (is-equal 0 (json-object-count (parse "{}")))
  (is-equal 0 (json-object-count (parse "{ }"))))

(deftest object-preserves-insertion-order (:suite "json")
  (is-equal '("z" "a" "m") (json-keys (parse "{\"z\":1,\"a\":2,\"m\":3}"))))

(deftest duplicate-keys-policy (:suite "json")
  (signals json-parse-error (parse "{\"a\":1,\"a\":2}"))
  (let ((first (make-json-limits :duplicate-keys :first))
        (last (make-json-limits :duplicate-keys :last)))
    (is-equal 1 (json-get (json-parse "{\"a\":1,\"a\":2}" :limits first) "a"))
    (is-equal 2 (json-get (json-parse "{\"a\":1,\"a\":2}" :limits last) "a"))))

(deftest encode-basics (:suite "json")
  (is-equal "null" (json-encode nil))
  (is-equal "null" (json-encode :null))
  (is-equal "true" (json-encode :true))
  (is-equal "true" (json-encode t))
  (is-equal "false" (json-encode :false))
  (is-equal "42" (json-encode 42))
  (is-equal "-7" (json-encode -7))
  (is-equal "1.5" (json-encode 1.5d0))
  (is-equal "2" (json-encode 2.0d0))
  (is-equal "0.5" (json-encode 1/2))
  (is-equal "\"hi\"" (json-encode "hi"))
  (is-equal "[1,2,3]" (json-encode #(1 2 3)))
  (is-equal "[1,2,3]" (json-encode '(1 2 3)))
  (is-equal "{\"a\":1,\"b\":[true]}" (json-encode (make-json-object "a" 1 "b" #(:true))))
  (is-equal "\"foo\"" (json-encode :foo)))

(deftest encode-escapes (:suite "json")
  (is-equal "\"\\\"\\\\\"" (json-encode "\"\\"))
  (is-equal "\"\\n\\r\\t\\b\\f\"" (json-encode (coerce (list #\Newline #\Return #\Tab (code-char 8) (code-char 12)) 'string)))
  (is-equal "\"\\u0001\"" (json-encode (string (code-char 1))))
  (is-equal "\"\\u003Cscript\\u003E\"" (json-encode "<script>"))
  (is-equal "\"\\u0026\"" (json-encode "&"))
  (is-equal "\"\\u2028\"" (json-encode (string (code-char #x2028))))
  (let ((*escape-html* nil))
    (is-equal "\"<b>\"" (json-encode "<b>"))))

(deftest encode-rejects-non-finite (:suite "json")
  (signals json-encode-error (json-encode (sb-kernel:make-double-float -524288 0)))  ; NaN
  (signals json-encode-error (json-encode sb-ext:double-float-positive-infinity)))

(deftest encode-rejects-unknown-types (:suite "json")
  (signals json-encode-error (json-encode (make-json-limits))))

(deftest encode-hash-table (:suite "json")
  (let ((h (make-hash-table :test 'equal)))
    (setf (gethash "k" h) 1)
    (is-equal "{\"k\":1}" (json-encode h))))

(deftest roundtrip-structures (:suite "json")
  (dolist (text '("{\"a\":[1,2,{\"b\":null}],\"c\":\"d\",\"e\":true,\"f\":false,\"g\":-1.25}"
                  "[]" "{}" "[[[]]]" "123456789012345678901234567890"))
    (is-equal text (roundtrip text))))

(deftest unicode-roundtrip (:suite "json")
  (let ((s (coerce (list (code-char #xE9) (code-char #x4E2D) (code-char #x1F600)) 'string)))
    (is-equal s (json-parse (json-encode s)))))

(deftest json-get-second-value (:suite "json")
  (let ((obj (make-json-object "present" :null)))
    (multiple-value-bind (v found) (json-get obj "present")
      (is-equal :null v) (is found))
    (multiple-value-bind (v found) (json-get obj "absent")
      (is-equal nil v) (is-false found))))

(deftest json-set-replaces-without-duplicating-keys (:suite "json")
  (let ((obj (make-json-object "a" 1)))
    (json-set obj "a" 2)
    (is-equal '("a") (json-keys obj))
    (is-equal 2 (json-get obj "a"))))

(deftest parse-octets-directly (:suite "json")
  (is-equal #(1 2) (json-parse-octets (sb-ext:string-to-octets "[1,2]")) 'equalp)
  (is-equal #(2) (json-parse-octets (sb-ext:string-to-octets "xx[2]yy") :start 2 :end 5) 'equalp))
